# minty-accounts-api - local values. Copy to .env (never committed).
APP_ENV=development
# The same SECRET_KEY as Flask and the other three APIs.
SECRET_KEY=
# Where every request Django does not route goes: Flask, locally on 8000. 127.0.0.1, not
# localhost: Windows tries ::1 first and Flask listens on IPv4 only, so each hop waits 2 s.
FLASK_FALLBACK_URL=http://127.0.0.1:8000
# The shared schema (local dev: the postgres database). Required.
DATABASE_URL=postgresql://postgres:@localhost:5432/postgres?schema=pettycashv3
# Xero's OAuth client, the same app as Flask's (XERO_CLIENT_ID / XERO_CLIENT_SECRET there).
# The local databases are production copies: a real refresh here spends a copied production
# refresh token and breaks that company's live connection. Use placeholders unless you mean it.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
DJANGO_DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
# This service's public address (emailed links); required outside development.
ACCOUNTS_API_URL=http://localhost:8002
# Mail (smtp://user:pass@host:587, ?tls=0, ?timeout=); required outside development.
SMTP_URL=
# The invitation's From - required, a verified sender.
INVITE_FROM=
# Talk to Minty: where messages go, and who sends them (unset: the contact route answers 500).
CONTACT_EMAIL=
CONTACT_FROM=
# The front ends the hub's CORS admits (defaults: localhost 3000 / 3020 / 3010 / 3030).
MINTY_WEB_URL=http://localhost:3000
PAYMENT_REQUEST_WEB_URL=http://localhost:3020
PETTY_CASH_WEB_URL=http://localhost:3010
ONBOARDING_WEB_URL=http://localhost:3030
# minty-subscription-api, asked for the hub's subscription facts. 127.0.0.1, not localhost: Windows
# tries ::1 first and runserver listens on IPv4 only, so every call waits about 2 s.
SUBSCRIPTION_API_URL=http://127.0.0.1:8001
# Optional: a branch's preview set, and a second copy of the front ends (app=https://host,...).
PREVIEW_ORIGIN_REGEX=
EXTRA_FRONTEND_ORIGINS=
