# minty-accounts-api - local values. Copy to .env (never committed).
APP_ENV=development
# The same SECRET_KEY as Flask and the other three APIs.
SECRET_KEY=
# Where every request Django does not route goes: Flask, locally on 8000. 127.0.0.1, not
# localhost: Windows tries ::1 first and Flask listens on IPv4 only, so each hop waits 2 s.
FLASK_FALLBACK_URL=http://127.0.0.1:8000
DJANGO_DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
